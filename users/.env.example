# Copy to .env.dev for npm run dev, or .env for npm start / Compose.
# Local placeholders only. Never commit populated files.
PORT=8001
# The service appends its database name to this prefix.
MONGODB_URI=mongodb://127.0.0.1:27017/
JWT_SECRET=replace-with-shared-local-signing-secret
MSG_QUEUE_URL=amqp://127.0.0.1:5672
EXCHANGE_NAME=zoro_local
CLOUD_NAME=replace-with-development-cloud-name
API_KEY=replace-with-development-api-key
API_SECRET=replace-with-development-api-secret
